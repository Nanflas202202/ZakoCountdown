<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:fitsSystemWindows="true"
        android:background="@android:color/transparent">
        <!-- 重点：AppBarLayout 透明，颜色由 CollapsingToolbar 的 ContentScrim 控制 -->

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="?attr/colorPrimary"
            app:statusBarScrim="?attr/colorPrimaryVariant"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:expandedTitleMarginStart="24dp"
            app:expandedTitleMarginBottom="28dp"
            app:expandedTitleTextAppearance="?attr/textAppearanceHeadlineMedium"
            app:collapsedTitleTextAppearance="?attr/textAppearanceTitleLarge">

            <ImageView
                android:id="@+id/iv_header_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7" />

            <View
                android:id="@+id/v_header_scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000"/>

            <!-- 优化：Toolbar 背景透明，让其与下层融为一体 -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 日程列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_events"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!--
        原本这里有一个「快捷添加日程」FAB，已移除。
        原因：它同时出现在普通日程本与默认本（全部 / 重点）上，
        而它只是跳到通用的新建页并预选本子，容易让人误以为
        「往当前这个本子里加」。日程的添加入口在主页与日程本页右下角，
        功能并不缺，删掉反而少一处歧义。
    -->

</androidx.coordinatorlayout.widget.CoordinatorLayout>
