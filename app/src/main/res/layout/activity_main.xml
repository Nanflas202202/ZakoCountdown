<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
        主内容区域用 CoordinatorLayout 承载：
        底部导航栏挂在它下面，并挂上 ZakoFloatingNavBehavior，
        从而能响应内部列表的嵌套滚动（下滑自动隐藏、上滑自动回来）。

        ⚠️ android:background 是必须的：
        底栏在这里是覆盖层，自动隐藏时它会滑出屏幕，露出 CoordinatorLayout 自身。
        如果不设背景，露出的就是 DrawerLayout 后面的**窗口底色**，
        在主页那种「内容铺 surface 色」的页面上会看到一条明显发白的横条。
        给容器铺上同一族的 surface 色，滑出后就与内容连成一片，看不出接缝。
    -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/app_name"
                style="?attr/toolbarStyle" />

            <!-- 横向容器：容纳侧边导航轨和 Fragment -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- MD3 规范：横屏/平板专属的 Navigation Rail -->
                <com.google.android.material.navigationrail.NavigationRailView
                    android:id="@+id/nav_rail_view"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:menu="@menu/bottom_nav_menu"
                    android:visibility="gone" />

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/nav_host_fragment"
                    android:name="androidx.navigation.fragment.NavHostFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:defaultNavHost="true"
                    app:navGraph="@navigation/nav_graph" />
            </LinearLayout>
        </LinearLayout>

        <!--
            底部导航栏（悬浮 / 贴底共用）。

            布局对齐到底部，并在**代码里**给它加 bottom margin 抬高，而不是靠
            android:layout_marginBottom —— 因为 Behavior 要用「高度 + bottomMargin」
            算出滑出屏幕的距离，让它在下滑时完整地藏到屏幕外面。

            悬浮外观（左右留白、药丸圆角、投影）由 MainActivity.applyBottomBarAppearance() 控制。
        -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:minHeight="64dp"
            app:elevation="6dp"
            app:layout_behavior="com.errorsiayusulif.zakocountdown.utils.ZakoFloatingNavBehavior"
            app:menu="@menu/bottom_nav_menu"
            android:visibility="gone"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu" />

    <!-- 右侧侧滑栏 (日程本筛选) -->
    <LinearLayout
        android:id="@+id/right_drawer_container"
        style="@style/Widget.Zako.RightDrawer"
        android:orientation="vertical">

        <include
            android:id="@+id/right_header"
            layout="@layout/nav_header_right" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_agenda"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:scrollbars="vertical"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
