<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================= -->
    <!-- =====   1. 组件样式定义 (Button 强制着色)   === -->
    <!-- ============================================= -->

    <!-- MD1 按钮: 直角，高阴影，强制使用 Primary 色 -->
    <style name="Widget.Zako.Button.MD1" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">2dp</item>
        <item name="elevation">4dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorOnPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- MD2 按钮: 4dp圆角，强制使用 Primary 色 -->
    <style name="Widget.Zako.Button.MD2" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">4dp</item>
        <item name="elevation">2dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorOnPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- MD3 按钮: 保持默认，跟随动态色 -->
    <style name="Widget.Zako.Button.M3" parent="Widget.Material3.Button" />

    <!-- MD1 开关 -->
    <style name="Widget.Zako.Switch.MD1" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <!-- MD2 开关 -->
    <style name="Widget.Zako.Switch.MD2" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>
    <!-- ... (CardView, Toolbar 样式保持不变) ... -->
    <style name="Widget.ZakoCountdown.CardView.MD1" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">2dp</item>
        <item name="cardElevation">6dp</item>
    </style>
    <style name="Widget.ZakoCountdown.CardView.MD2" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
    </style>
    <style name="Widget.ZakoCountdown.Toolbar.MD1" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="subtitleTextColor">#FFFFFF</item>
        <item name="navigationIconTint">#FFFFFF</item>
        <item name="actionMenuTextColor">#FFFFFF</item>
    </style>
    <style name="Widget.ZakoCountdown.Toolbar.MD2.Surface" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
    </style>

    <!-- ============================================= -->
    <!-- =====   3. 基础骨架 (绑定组件样式)      ====== -->
    <!-- ============================================= -->

    <!--
        Material 3 扩展色彩角色补充层。
        MaterialComponents 主题并没有定义 colorSurfaceVariant / colorOutline /
        colorPrimaryContainer 等 M3 角色，导致 MtbThemeEngine 在 MD1/MD2 下只能
        回退到默认色，界面配色因此无法统一。
        这里统一补齐，MD1/MD2 都继承它，日间/夜间分别取值。
    -->
    <style name="Theme_ZakoCountdown.ColorRoles" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorSurface">@color/zako_color_surface</item>
        <item name="colorOnSurface">@color/zako_color_on_surface</item>
        <item name="colorSurfaceVariant">@color/zako_color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/zako_color_on_surface_variant</item>
        <item name="colorOutline">@color/zako_color_outline</item>
        <item name="colorOutlineVariant">@color/zako_color_outline_variant</item>
        <item name="colorPrimaryContainer">@color/zako_color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/zako_color_on_primary_container</item>
        <item name="colorSecondary">@color/zako_color_secondary</item>
        <item name="colorOnSecondary">@color/zako_color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/zako_color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/zako_color_on_secondary_container</item>
        <item name="colorError">@color/zako_color_error</item>
        <item name="colorOnError">@color/zako_color_on_error</item>

        <!-- Expressive 的层次色阶：悬浮导航栏 / 分组卡片靠它拉开层次，不依赖阴影 -->
        <item name="colorSurfaceContainerLowest">@color/zako_color_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/zako_color_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/zako_color_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/zako_color_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/zako_color_surface_container_highest</item>
        <item name="colorSurfaceBright">@color/zako_color_surface_bright</item>
        <item name="colorSurfaceDim">@color/zako_color_surface_dim</item>

        <!--
            窗口底色显式设为 surface。
            自动隐藏的底部导航栏是覆盖层，它滑出屏幕后会露出窗口底色；
            不显式指定时由各父主题决定，可能出现内容(surface)与窗口底色不一致、
            底部露出一条明显色差的情况。
        -->
        <item name="android:windowBackground">@color/zako_color_surface</item>
    </style>

    <!-- MD1 Base -->
    <style name="Theme_ZakoCountdown_Base_MD1" parent="Theme_ZakoCountdown.ColorRoles">
        <item name="materialButtonStyle">@style/Widget.Zako.Button.MD1</item>
        <item name="switchStyle">@style/Widget.Zako.Switch.MD1</item>
        <!-- 其他组件使用 AppCompat 默认 -->

        <item name="materialCardViewStyle">@style/Widget.ZakoCountdown.CardView.MD1</item>
        <item name="toolbarStyle">@style/Widget.ZakoCountdown.Toolbar.MD1</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="navigationViewStyle">@style/Widget.MaterialComponents.NavigationView</item>
        <item name="android:windowTranslucentStatus">false</item>
        <!-- 让 outlined 按钮继承适合旧版主题的描边与文字色 -->
        <item name="materialButtonOutlinedStyle">@style/Widget.Zako.Button.Outlined</item>
    </style>

    <!-- MD2 Base -->
    <style name="Theme_ZakoCountdown_Base_MD2" parent="Theme_ZakoCountdown.ColorRoles">
        <item name="materialButtonStyle">@style/Widget.Zako.Button.MD2</item>
        <item name="switchStyle">@style/Widget.Zako.Switch.MD2</item>

        <item name="materialCardViewStyle">@style/Widget.ZakoCountdown.CardView.MD2</item>
        <item name="toolbarStyle">@style/Widget.ZakoCountdown.Toolbar.MD2.Surface</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <!-- 让 outlined 按钮继承适合旧版主题的描边与文字色 -->
        <item name="materialButtonOutlinedStyle">@style/Widget.Zako.Button.Outlined</item>
    </style>

    <!-- 旧版主题的填充按钮（M2 规范），MD1/MD2 都用它，避免引擎去猜 -->
    <style name="Widget.Zako.Button.Filled" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="rippleColor">?attr/colorOnPrimary</item>
    </style>

    <!-- 旧版主题的描边按钮（M2 规范） -->
    <style name="Widget.Zako.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- 旧版主题的文字按钮 -->
    <style name="Widget.Zako.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- MD3 Base -->
    <style name="Theme_ZakoCountdown_Base_M3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar.Surface</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

