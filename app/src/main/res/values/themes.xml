    <!-- Drawer Styles -->
    <style name="Widget.Zako.RightDrawer" parent="">
        <item name="android:layout_width">300dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!--
        右侧筛选抽屉的顶栏。
        layout_height 用固定值而不是 wrap_content：顶栏现在是一个 FrameLayout，
        里面有一层 match_parent 的自定义顶图。若高度是 wrap_content，
        这层图就失去了可参照的高度、会被压成 0（表现就是「设了图却看不到」）。
    -->
    <style name="Widget.Zako.RightHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>
    <style name="Widget.Zako.RightDrawer.M3" parent="Widget.Zako.RightDrawer">
        <item name="android:background">@drawable/bg_drawer_right_m3</item>
    </style>
    <style name="Widget.Zako.RightDrawer.Legacy" parent="Widget.Zako.RightDrawer">
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="Theme.ZakoCountdown" parent="Theme_ZakoCountdown_M3" />
    <style name="Theme.ZakoCountdown.Popup" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

