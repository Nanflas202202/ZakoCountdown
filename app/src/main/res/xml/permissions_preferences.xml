<!-- file: res/xml/permissions_preferences.xml (终极修复版) -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/perm_category_basic">
        <Preference
            app:key="permission_notification"
            app:title="@string/perm_notification"
            app:summary="@string/perm_notification_summary"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/perm_category_background">
        <Preference
            app:key="permission_exact_alarm"
            app:title="@string/perm_exact_alarm"
            app:summary="@string/perm_exact_alarm_summary"/>
        <Preference
            app:key="permission_battery_optimization"
            app:title="@string/perm_battery_optimization"
            app:summary="@string/perm_battery_optimization_summary"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/perm_category_advanced">
        <!-- 【修复】移除 <intent> 标签 -->
        <Preference
            app:key="enable_accessibility"
            app:title="@string/perm_accessibility"
            app:summary="@string/perm_accessibility_summary"/>
        <Preference
            app:key="permission_overlay"
            app:title="@string/perm_overlay"
            app:summary="@string/perm_overlay_summary"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/perm_category_oem">
        <Preference
            app:key="permission_autostart"
            app:title="@string/perm_autostart"
            app:summary="@string/perm_autostart_summary"/>
        <Preference
            app:key="permission_miui_background"
            app:title="@string/perm_miui_background"
            app:summary="@string/perm_miui_background_summary"
            app:isPreferenceVisible="false"/>
    </PreferenceCategory>
</PreferenceScreen>
