<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/dev_category_theme">
        <!-- 新增开关 -->
        <SwitchPreferenceCompat
            app:key="legacy_theme_unlock_in_compact"
            app:title="@string/dev_unlock_legacy_theme_compact"
            app:summary="@string/dev_unlock_legacy_theme_compact_summary"
            app:defaultValue="false" />

        <SwitchPreferenceCompat
            app:key="show_system_apps"
            app:title="@string/dev_show_system_apps"
            app:summary="@string/dev_show_system_apps_summary"
            app:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/dev_category_compat">
        <SwitchPreferenceCompat
            app:key="miui_fix_disabled"
            app:title="@string/dev_miui_fix_override"
            app:summary="@string/dev_miui_fix_override_summary"
            app:defaultValue="false" />
    </PreferenceCategory>
    <SwitchPreferenceCompat
        app:key="md1_theme_enabled"
        app:title="@string/dev_enable_md1"
        app:summary="@string/dev_enable_md1_summary"
        app:defaultValue="false" />
    <PreferenceCategory app:title="@string/dev_category_popup">
        <Preference
            app:key="current_rom"
            app:title="@string/dev_current_rom"
            app:summary="@string/dev_unknown"/>
        <ListPreference
            app:key="popup_mode"
            app:title="@string/dev_force_popup_mode"
            app:summary="@string/dev_force_popup_mode_summary"
            app:entries="@array/popup_mode_entries"
            app:entryValues="@array/popup_mode_values"
            app:defaultValue="auto"/>
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/dev_category_personalization">
        <SwitchPreferenceCompat
            app:key="card_alpha_unlocked"
            app:title="@string/adv_unlock_global_alpha"
            app:summary="@string/adv_unlock_global_alpha_summary"
            app:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/dev_category_feature_test">
        <SwitchPreferenceCompat
            app:key="agenda_book_enabled"
            app:title="@string/dev_enable_agenda_book"
            app:summary="@string/dev_enable_agenda_book_summary"
            app:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/dev_category_debug">
        <Preference
            app:key="force_relaunch_oobe"
            app:title="@string/dev_force_relaunch_oobe"
            app:summary="@string/dev_force_relaunch_oobe_summary" />

        <Preference
            app:key="clear_all_preferences"
            app:title="@string/dev_clear_preferences"
            app:summary="@string/dev_clear_preferences_summary" />

        <!--
            防沉迷诊断。
            原先挂在「高级设置 → 防沉迷 → 诊断」下。
            它只有在排查问题时才有用，对普通用户是噪声，
            所以收进调试台 —— 需要看的时候能找到，平时不占主流程。
        -->
        <Preference
            app:key="focus_view_log"
            app:title="@string/focus_view_log"
            app:summary="@string/focus_view_log_summary" />

        <Preference
            app:key="focus_dump_config"
            app:title="@string/focus_dump_config"
            app:summary="@string/focus_dump_config_summary" />
    </PreferenceCategory>

    <!--
        构建标识：升级代号 + 构建指纹。
        这里是**唯一**能看到升级代号的地方 —— 关于页、设置页、备份包里都不出现。
    -->
    <PreferenceCategory app:title="@string/dev_category_build_identity">
        <Preference
            app:key="upgrade_code_display"
            app:title="@string/dev_upgrade_code"
            app:summary="@string/dev_upgrade_code_summary" />

        <Preference
            app:key="build_id_display"
            app:title="@string/dev_build_id"
            app:summary="@string/dev_build_id_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/dev_category_update_nodes">
        <SwitchPreferenceCompat
            app:key="update_source_sync_enabled"
            app:title="@string/dev_sync_update_urls"
            app:summary="@string/dev_sync_update_urls_summary"
            app:defaultValue="true" />

        <EditTextPreference
            app:key="update_source_nodes"
            app:title="@string/dev_custom_update_urls"
            app:summary="@string/dev_custom_update_urls_summary"
            app:dialogTitle="@string/dev_custom_update_urls_dialog_title"
            app:dialogMessage="@string/dev_custom_update_urls_dialog_message"/>

        <!-- 一键恢复内置节点池，避免用户误清空后无从下手 -->
        <Preference
            app:key="restore_default_update_urls"
            app:title="@string/dev_restore_default_urls"
            app:summary="@string/dev_restore_default_urls_summary" />
    </PreferenceCategory>
</PreferenceScreen>
